# General Application Settings
APP_ENV=development
SERVICE_NAME=CredVoice
LOG_LEVEL=INFO

# LLM Provider Configuration
# Set LLM_PROVIDER to 'openai' (default) or 'gemini'
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
# For Gemini: set LLM_PROVIDER=gemini and LLM_MODEL=gemini-2.0-flash (or another Gemini model)
# GEMINI_API_KEY must be set when LLM_PROVIDER=gemini. Never commit a real key here.
GEMINI_API_KEY=your_gemini_api_key_here
RUN_LIVE_LLM_TESTS=false

# Voice Platform Integration
VOICE_PROVIDER=retell
RETELL_API_KEY=your_retell_api_key_here
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret_here
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_WEBHOOK_SECRET=your_bolna_webhook_secret_here
PUBLIC_WEBHOOK_BASE_URL=http://localhost:8000
SESSION_TTL_SECONDS=3600
VERIFY_WEBHOOK_SIGNATURES=false

# Security & Multi-Worker Production Configuration
ADMIN_API_KEY=your_admin_api_key_here
CORS_ORIGINS=["*"]
MAX_REQUEST_BODY_BYTES=1048576
SESSION_STORE_TYPE=memory
REDIS_URL=

# Language Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=["en", "hi"]

# Product Knowledge Base / RAG Configuration
ENABLE_RAG=true
KNOWLEDGE_BASE_PATH=knowledge/lap_faq.json
